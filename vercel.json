{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs24.x",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/bridge/status",
      "destination": "/api/bridge/status"
    },
    {
      "source": "/bridge/providers/runtime-status",
      "destination": "/api/bridge/providers/runtime-status"
    },
    {
      "source": "/bridge/social-media/draft",
      "destination": "/api/bridge/social-media/draft"
    },
    {
      "source": "/workflows/eden-launch",
      "destination": "/api/workflows/eden-launch"
    },
    {
      "source": "/workflows/eden-launch/contract",
      "destination": "/api/workflows/eden-launch/contract"
    },
    {
      "source": "/factory/readiness",
      "destination": "/api/factory/readiness"
    },
    {
      "source": "/factory/router",
      "destination": "/api/factory/router"
    },
    {
      "source": "/factory/build-packet",
      "destination": "/api/factory/build-packet"
    },
    {
      "source": "/factory/capability-test",
      "destination": "/api/factory/capability-test"
    }
  ],
  "crons": [
    {
      "path": "/api/jobs/daily-sync",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/jobs/queue-sweep",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/factory-readiness",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/social-bridge",
      "schedule": "*/5 * * * *"
    }
  ]
}
