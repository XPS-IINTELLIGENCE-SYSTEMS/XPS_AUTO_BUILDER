{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs24.x",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/bridge/status",
      "destination": "/api/bridge/status"
    }
  ],
  "crons": [
    {
      "path": "/api/jobs/daily-sync",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/jobs/queue-sweep",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/factory-readiness",
      "schedule": "*/5 * * * *"
    }
  ]
}
